<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Welcome!{% endblock %}</title>

    <!-- Favicon par défaut -->
    <link rel="icon" href="data:image/svg+xml,
        <svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22>
            <text y=%221.2em%22 font-size=%2296%22>⚫️</text>
            <text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text>
        </svg>">

    {% block stylesheets %}
        {{ parent() }}
        <!-- Thème jQuery UI depuis le CDN -->
        <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
    {% endblock %}
</head>

<body>
    {% block body %}{% endblock %}

    {% block javascripts %}
        {{ parent() }}
        <!-- jQuery de base -->
        <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

        <!-- jQuery UI complet (doit inclure mouse) -->
        <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>

        <!-- Touch Punch (après jQuery UI pour la compatibilité mobile/tactile) -->
        <script src="https://cdnjs.cloudflare.com/ajax/libs/jqueryui-touch-punch/0.2.3/jquery.ui.touch-punch.min.js"></script>
    {% endblock %}

</body>
</html>
